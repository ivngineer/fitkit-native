# Copy to .env and fill in. Keys are only ever read by the server.
FITKIT_ADDR=:8080
FITKIT_DATA_DIR=./data
FITKIT_IMPORT_PIN_LIMIT=250
FITKIT_IMPORT_WORKERS=2
FITKIT_SESSION_TTL_DAYS=60

# Set to 1 to use placeholder analysis results instead of the paid providers.
FITKIT_DEMO_ANALYSIS=0

# Object detection
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the model above is overloaded (HTTP 503) or missing from
# the key's catalogue, which free keys hit often.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Crop hosting
IMGBB_API_KEY=

# Reverse image search: serpapi | scrapingdog | searchapi
# Preferred visual search provider; any other provider with a key below is
# used as a fallback.
LENS_PROVIDER=searchapi
SERPAPI_API_KEY=
SCRAPINGDOG_API_KEY=
SEARCHAPI_API_KEY=

# Checkout. Fitkit never takes payment; these only tag store links so
# purchases can earn an affiliate commission. All optional.
# Amazon Associates tag per site: US, UK, DE, FR, IT, ES, NL, PL, SE, BE, IE.
AMAZON_ASSOCIATE_TAG_US=
AMAZON_ASSOCIATE_TAG_DE=
ALIEXPRESS_AFFILIATE_KEY=
# Sub-affiliate network (Skimlinks) for every other affiliate store.
SKIMLINKS_PUBLISHER_ID=
# Send Shopify checkouts straight to Shop Pay.
SHOPIFY_SHOP_PAY=1
